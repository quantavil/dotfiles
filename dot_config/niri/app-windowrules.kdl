// Apps that always open as a normal 2/3-width tiled column instead of the
// 0.5 global default. The Craft apps also restore their own maximized state on
// launch, so maximize/fullscreen requests are refused for the whole list.
// Add one `match app-id=` line per app; find the id with `niri msg windows`
// while the app is open (field "App ID"). Keep each pattern anchored to the
// full id to avoid false matches. All match lines in a rule are a logical OR.
window-rule {
    match app-id=r#"^ai\.storyteller\.deckcraft$"#
    match app-id=r#"^ai\.storyteller\.gridcraft$"#
    match app-id=r#"^ai\.storyteller\.pdfcraft$"#
    match app-id=r#"^ai\.storyteller\.photocraft$"#
    match app-id=r#"^ai\.storyteller\.wordcraft$"#
    match app-id=r#"^md\.obsidian\.Obsidian$"#
    match app-id=r#"^zen$"#
    default-column-width { proportion 0.66667; }
    open-maximized false
    open-fullscreen false
}

// Chromium and CloakBrowser (the ImpexCube agent browser) both report app id chromium-browser.
// They open full width, not the 0.5 global default.
window-rule {
    match app-id=r#"^chromium-browser$"#
    default-column-width { proportion 1.0; }
}

// Add further 2/3-width apps as extra match lines in the first rule above, for example:
//     match app-id=r#"^org\.example\.app$"#
