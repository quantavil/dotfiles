#!/bin/sh
# Re-apply hand-picked MIME defaults without managing ~/.config/mimeapps.list.
#
# That file is rewritten at runtime (xdg-mime, Telegram, ChatGPT/Claude URL
# handlers) and userapp-*.desktop IDs are generated per installation, so a
# committed copy always fights live state. This script is idempotent, skips
# anything that is not installed, and discovers scheme handlers instead of
# hardcoding their IDs.

set -eu

# Refresh handler cache so newly installed desktop entries are visible to MIME
# lookups (CloakBrowser and friends ship as chezmoi-managed .desktop files).
update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true

have_desktop() {
    [ -f "/usr/share/applications/$1" ] || [ -f "$HOME/.local/share/applications/$1" ]
}

set_default() {
    mime=$1
    app=$2
    have_desktop "$app" || return 0
    xdg-mime default "$app" "$mime"
}

while IFS='=' read -r mime app; do
    [ -n "$mime" ] || continue
    set_default "$mime" "$app"
done <<'MIMES'
text/html=zen.desktop
x-scheme-handler/http=zen.desktop
x-scheme-handler/https=zen.desktop
x-scheme-handler/about=zen.desktop
x-scheme-handler/unknown=zen.desktop
application/xhtml+xml=zen.desktop
inode/directory=org.gnome.Nautilus.desktop
application/pdf=ai.storyteller.pdfcraft.desktop
x-scheme-handler/geo=google-maps-geo-handler.desktop
application/x-shellscript=com.microsoft.VSCode.desktop
application/json=com.microsoft.VSCode.desktop
application/javascript=com.microsoft.VSCode.desktop
application/typescript=com.microsoft.VSCode.desktop
application/x-code-workspace=com.microsoft.VSCode.desktop
application/x-ipynb+json=com.microsoft.VSCode.desktop
application/x-jupyter-notebook=com.microsoft.VSCode.desktop
application/yaml=com.microsoft.VSCode.desktop
application/toml=com.microsoft.VSCode.desktop
application/sql=com.microsoft.VSCode.desktop
application/xml=com.microsoft.VSCode.desktop
application/x-ruby=com.microsoft.VSCode.desktop
application/x-perl=com.microsoft.VSCode.desktop
application/x-php=com.microsoft.VSCode.desktop
application/vnd.dart=com.microsoft.VSCode.desktop
application/vnd.ms-excel=ai.storyteller.gridcraft.desktop
application/vnd.ms-excel.sheet.macroEnabled.12=ai.storyteller.gridcraft.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=ai.storyteller.gridcraft.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.document=ai.storyteller.wordcraft.desktop
application/msword=ai.storyteller.wordcraft.desktop
