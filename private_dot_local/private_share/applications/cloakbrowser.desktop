[Desktop Entry]
Type=Application
Name=CloakBrowser
GenericName=Stealth Web Browser
Comment=CloakBrowser stealth Chromium with a stable fingerprint seed
Exec=/home/quantavil/.local/bin/cloakbrowser-chrome --user-data-dir=/home/quantavil/.config/cloakbrowser %U
Icon=chromium-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupNotify=true
StartupWMClass=chromium-browser
