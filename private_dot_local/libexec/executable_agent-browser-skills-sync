#!/usr/bin/env python3
"""Install the runtime skills matching a mise-installed agent-browser."""
import base64
import hashlib
import io
import json
import os
from pathlib import Path
import shutil
import tarfile
import tempfile
import urllib.request

version = os.environ['MISE_TOOL_VERSION']
root = Path(os.environ['MISE_TOOL_INSTALL_PATH'])
with urllib.request.urlopen(f'https://registry.npmjs.org/agent-browser/{version}', timeout=30) as response:
    package = json.load(response)
with urllib.request.urlopen(package['dist']['tarball'], timeout=120) as response:
    archive = response.read()
expected = package['dist']['integrity']
actual = 'sha512-' + base64.b64encode(hashlib.sha512(archive).digest()).decode()
if expected != actual:
    raise SystemExit('agent-browser skills archive checksum mismatch')
with tempfile.TemporaryDirectory(dir=root) as temp:
    with tarfile.open(fileobj=io.BytesIO(archive), mode='r:gz') as tar:
        members = [m for m in tar.getmembers() if m.name.startswith('package/skill-data/')]
        if not members:
            raise SystemExit('agent-browser archive has no runtime skills')
        tar.extractall(temp, members=members, filter='data')
    source = Path(temp) / 'package/skill-data'
    if not (source / 'core/SKILL.md').is_file():
        raise SystemExit('agent-browser core skill missing')
    target = root / 'skill-data'
    if target.exists():
        shutil.rmtree(target)
    source.rename(target)
print(f'Installed agent-browser {version} runtime skills')
