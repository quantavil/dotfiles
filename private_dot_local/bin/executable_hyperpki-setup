#!/usr/bin/env bash
# Set up a Hypersecu HYP2003 token on a CachyOS/Arch machine.
set -euo pipefail

usage() { printf 'Usage: hyperpki-setup /path/to/HyperPKI_HYP2003_Setup.exe\n       hyperpki-setup --reader-only\n' >&2; }
if [[ $# != 1 ]]; then usage; exit 2; fi
mode=$1
if [[ $mode != --reader-only && ! -f $mode ]]; then usage; exit 2; fi
for cmd in python3 pkexec systemctl pcsc_scan; do
    command -v "$cmd" >/dev/null || { printf 'Missing command: %s\n' "$cmd" >&2; exit 1; }
done
if [[ $mode != --reader-only ]]; then
    for cmd in wine winetricks; do
        command -v "$cmd" >/dev/null || { printf 'Missing command: %s\n' "$cmd" >&2; exit 1; }
    done
fi
stock=/usr/lib/pcsc/drivers/ifd-ccid.bundle/Contents/Info.plist
lib=/usr/lib/pcsc/drivers/ifd-ccid.bundle/Contents/Linux/libccid.so
bundle=/usr/local/lib/icegate-ccid/ifd-ccid.bundle/Contents
service=/etc/systemd/system/pcscd.service.d/hyp2003.conf
[[ -r $stock && -r $lib ]] || { echo 'Install the ccid package first.' >&2; exit 1; }
if [[ -e $service ]] && ! grep -Fxq 'Environment=PCSCLITE_HP_DROPDIR=/usr/local/lib/icegate-ccid' "$service"; then
    echo "Refusing to overwrite existing $service" >&2; exit 1
fi
if [[ -e $bundle/Linux/libccid.so || -L $bundle/Linux/libccid.so ]]; then
    [[ -L $bundle/Linux/libccid.so && $(readlink "$bundle/Linux/libccid.so") == "$lib" ]] || { echo 'Unexpected existing CCID library; refusing to replace it.' >&2; exit 1; }
fi
tmp=$(mktemp -d)
trap 'rm -r -- "$tmp"' EXIT
python3 - "$stock" "$tmp/Info.plist" <<'PY'
import plistlib, sys
from pathlib import Path
with open(sys.argv[1], 'rb') as f:
    p = plistlib.load(f)
keys = ('ifdVendorID', 'ifdProductID', 'ifdFriendlyName')
arrays = [p[k] for k in keys]
if len({len(a) for a in arrays}) != 1:
    raise SystemExit('Unexpected CCID reader list format')
if not any(int(v, 0) == 0x2ccf and int(d, 0) == 0x080a for v, d in zip(*arrays[:2])):
    for a, v in zip(arrays, ('0x2CCF', '0x080A', 'Hypersecu HYP2003')):
        a.append(v)
with open(sys.argv[2], 'wb') as f:
    plistlib.dump(p, f, sort_keys=False)
PY
printf '%s\n' '[Service]' 'Environment=PCSCLITE_HP_DROPDIR=/usr/local/lib/icegate-ccid' > "$tmp/hyp2003.conf"
printf 'Installing reader configuration; system authentication may be requested.\n'
pkexec /usr/bin/install -D -m 644 "$tmp/Info.plist" "$bundle/Info.plist"
if [[ ! -L $bundle/Linux/libccid.so ]]; then
    pkexec /usr/bin/install -d -m 755 "$bundle/Linux"
    pkexec /usr/bin/ln -s "$lib" "$bundle/Linux/libccid.so"
fi
pkexec /usr/bin/install -D -m 644 "$tmp/hyp2003.conf" "$service"
pkexec /usr/bin/systemctl daemon-reload
pkexec /usr/bin/systemctl enable --now pcscd.socket
pkexec /usr/bin/systemctl try-restart pcscd.service
if [[ $mode != --reader-only ]]; then
    export WINEPREFIX="$HOME/.local/share/icegate-wine"
    export WINEDEBUG=-all
    printf 'Installing Wine runtime dependency and token manager.\n'
    winetricks -q mfc42
    wine "$mode" /S
    winepath='drive_c/Program Files (x86)/HyperPKI/HyperPKI_HYP2003/HyperPKITokenManager_HYP2003.exe'
    [[ -f $WINEPREFIX/$winepath ]] || { echo 'Manager installation not found; rerun the installer interactively.' >&2; exit 1; }
fi
printf '\nReader check (the USB token must be plugged in):\n'
pcsc_scan -r
printf '\nOpen HyperPKI Token Manager from the app menu or run hyperpki-token-manager.\n'
