#!/usr/bin/env bash
set -euo pipefail
vm_dir="$HOME/.local/share/icegate-vm"
runtime_dir="${XDG_RUNTIME_DIR:?}/icegate-windows"
mkdir -p "$runtime_dir" "$vm_dir/tpm"
exec 9>"$runtime_dir/lock"
flock -n 9 || { echo 'ICEGATE Windows VM is already running.' >&2; exit 1; }
[[ -f "$vm_dir/windows11.iso" ]] || { echo 'Windows installer ISO is not available yet.' >&2; exit 1; }
swtpm socket --tpm2 --tpmstate "dir=$vm_dir/tpm" --ctrl "type=unixio,path=$runtime_dir/tpm.sock" --pid "file=$runtime_dir/tpm.pid" --daemon
cleanup() { if [[ -f "$runtime_dir/tpm.pid" ]]; then kill "$(cat "$runtime_dir/tpm.pid")" 2>/dev/null || true; fi; rm -f "$runtime_dir/tpm.sock" "$runtime_dir/tpm.pid"; }
trap cleanup EXIT
qemu-system-x86_64 \
  -enable-kvm -machine q35 -cpu host -smp 4 -m 6G \
  -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2/x64/OVMF_CODE.4m.fd \
  -drive if=pflash,format=raw,file="$vm_dir/OVMF_VARS.fd" \
  -drive file="$vm_dir/windows.qcow2",format=qcow2,if=ide \
  -drive file="$vm_dir/windows11.iso",media=cdrom,readonly=on \
  -boot menu=on -display gtk -vga std \
  -device qemu-xhci,id=xhci -device usb-tablet,bus=xhci.0 \
  -device usb-host,bus=xhci.0,vendorid=0x2ccf,productid=0x080a \
  -chardev socket,id=chrtpm,path="$runtime_dir/tpm.sock" \
  -tpmdev emulator,id=tpm0,chardev=chrtpm -device tpm-tis,tpmdev=tpm0 \
  -netdev user,id=net0 -device e1000e,netdev=net0
