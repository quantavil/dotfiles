#!/usr/bin/env python3
"""Launch the newest installed licensed CloakBrowser with a profile seed."""
import os
from pathlib import Path
import random
import re
import sys

cache = Path.home() / '.cloakbrowser'
candidates = [p for p in cache.glob('chromium-*-pro/chrome') if p.is_file() and os.access(p, os.X_OK)]
def version(path):
    return tuple(int(n) for n in re.findall(r'\d+', path.parent.name))
if not candidates:
    raise SystemExit('CloakBrowser not installed: run cloakbrowser login and cloakbrowser install')
browser = max(candidates, key=version)
args = sys.argv[1:]
if not any(arg == '--fingerprint' or arg.startswith('--fingerprint=') for arg in args):
    seed = random.SystemRandom().randint(10000, 99999)
    profile = next((arg.split('=', 1)[1] for arg in args if arg.startswith('--user-data-dir=')), None)
    if profile:
        seedfile = Path(profile) / '.cloakbrowser-seed'
        seedfile.parent.mkdir(parents=True, exist_ok=True)
        try:
            with seedfile.open('x') as f:
                f.write(f'{seed}\n')
        except FileExistsError:
            try:
                value = int(seedfile.read_text().strip())
                if 10000 <= value <= 99999:
                    seed = value
            except (OSError, ValueError):
                pass
    args.append(f'--fingerprint={seed}')
os.execv(str(browser), [str(browser), *args])
